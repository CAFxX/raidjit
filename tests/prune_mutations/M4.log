=== M4: prune_versions() prunes the twin instead of the plain (inverted keep) ===
--- mutation diff (swapped twin_dominates args: when vs[j] is the tl=1 twin and vs[i] the tl=0 plain, vs[j] -- the twin -- is marked dominated) ---
--- /tmp/prune_mut/prune.c.pristine	2026-10-02 06:32:54.013844687 +0000
+++ src/prune.c	2026-10-02 06:46:25.882289964 +0000
@@ -140,7 +140,8 @@
         for (int j = 0; j < nv; j++) {
             if (i == j || dominated[j])
                 continue;
-            if (twin_dominates(&vs[i], &vs[j], verbose))
+            /* M4: inverted keep -- prune the twin instead of the plain */
+            if (twin_dominates(&vs[j], &vs[i], verbose))
                 dominated[j] = 1;
         }
     }
