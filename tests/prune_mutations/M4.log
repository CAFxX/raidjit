ar rcs build-x86_64/libraidjit.a build-x86_64/src/gf.o build-x86_64/src/plan.o build-x86_64/src/topo.o build-x86_64/src/bench.o build-x86_64/src/ref.o build-x86_64/src/api.o build-x86_64/src/prune.o build-x86_64/src/x86_64/cpu.o build-x86_64/src/x86_64/emit.o build-x86_64/src/x86_64/jit.o
