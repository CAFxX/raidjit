=== B4-M1: plan_candidates() drops all prefetch twins ===
--- mutation diff ---
--- /tmp/plan.c.b4orig	2026-10-03 18:04:03.554461897 +0000
+++ src/plan.c	2026-10-03 18:04:03.812675966 +0000
@@ -789,12 +789,16 @@
         }
     }
     if (prefetch_dist) {
+        /* B4-M1 mutation: drop all prefetch twins */
