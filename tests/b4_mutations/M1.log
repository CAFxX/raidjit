+        ntemp = n;
         for (int i = 0; i < ntemp && n < maxout; i++) {
             if (out[i].isa == ISA_RVV && !cpu->rvv_zicbop)
                 continue;
@@ -802,6 +806,7 @@
             out[n].prefetch_dist = prefetch_dist;
             n++;
         }
+        }
     }
     return n;
 }
