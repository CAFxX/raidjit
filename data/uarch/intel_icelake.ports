# Port model: Intel Ice Lake (client + server)
# uarch: RJ_UARCH_INTEL_ICELAKE, RJ_UARCH_INTEL
# Sources:
#   - uops.info (Ice Lake page, per-instruction port breakdowns)
#   - Agner Fog instruction_tables.pdf (Ice Lake section)
#   - Existing rj_uarch_weights_t (throughput priors, validated)
# Confidence: high (multiple sources agree on port assignments)
# Version: 1

uarch: INTEL_ICELAKE
version: 1

# Execution ports (throughput in uops/cycle)
# p0/p1: vector ALU; p2/p3: load AGU; p4: store data; p5: vector ALU/shuffle;
# p6: integer ALU; p7: store AGU
ports: p0=1.0 p1=1.0 p2=1.0 p3=1.0 p4=1.0 p5=1.0 p6=1.0 p7=1.0

# Instruction classes: port distribution (fractions sum to 1.0)
# VPTERNLOGD zmm: 1 uop, p0/p5 (uops.info: throughput 0.5)
class ternlog uops=1.0: p0=0.5 p5=0.5
# VPXORD zmm: 1 uop, p0/p5 (weight t_xor=0.50 => 2/cycle; p015 would be 3/cycle)
class xor uops=1.0: p0=0.5 p5=0.5
# VPSHUFB zmm: 1 uop, p5 (uops.info: throughput 1.0)
class shuffle uops=1.0: p5=1.0
# VGF2P8AFFINEQB zmm: 1 uop, p0 (uops.info: 1*p0, throughput 1.0;
# https://uops.info/html-instr/VGF2P8AFFINEQB_ZMM_K_ZMM_ZMM_I8.html)
# VGF2P8MULB zmm: 1 uop, p0 (uops.info: 1*p0, throughput 1.0;
# https://uops.info/html-instr/VGF2P8MULB_ZMM_K_ZMM_ZMM.html)
# NOTE (Agner vs uops.info): Agner Fog's Ice Lake table lists these as p01.
# uops.info's direct measurements show 1*p0 with measured throughput 1.00
# (loop and unrolled). We follow uops.info (primary measurement); Agner's
# p01 likely reflects an earlier stepping or less precise port attribution.
class gfni uops=1.0: p0=1.0
# VPCLMULQDQ zmm: 1 uop, p5 (uops.info: throughput 1.0)
class pclmul uops=1.0: p5=1.0
# VMOVDQA64 zmm load: 1 uop, p2/p3 (uops.info: throughput 0.5)
class load uops=1.0: p2=0.5 p3=0.5
# VMOVDQA64 zmm store: 2 uops (data + addr), p4 + p7
class store uops=1.0: p4=0.5 p7=0.5
# Scalar GPR (MOV/ADD/CMP): p6 (simplified; not on critical path)
class gpr uops=1.0: p6=1.0

# Scalar parameters (from rj_uarch_weights_t, kept for roofline)
scalar vec_bw=4.0
scalar mem_cpb=0.0078125
scalar freq512=1.0
scalar bw_bpc=8.0
